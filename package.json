{
  "name": "saju-offline-v2",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-oracle-atlas.js && node scripts/sync-rws-assets.js",
    "dev": "vite",
    "prebuild": "node scripts/build-oracle-atlas.js && node scripts/sync-rws-assets.js",
    "build": "vite build",
    "prepreview": "node scripts/build-oracle-atlas.js && node scripts/sync-rws-assets.js",
    "preview": "vite preview",
    "test": "node --test tests/*.test.js",
    "check:network": "node scripts/check-network.js",
    "check": "npm test && npm run check:network && npm run build",
    "visual:check": "playwright test",
    "assets:prepare": "node scripts/build-oracle-atlas.js && node scripts/sync-rws-assets.js",
    "pretest": "node scripts/build-oracle-atlas.js",
    "mobile:build": "npm run check && cd android && gradlew.bat assembleDebug",
    "predev:local": "node scripts/build-oracle-atlas.js && node scripts/sync-rws-assets.js",
    "dev:local": "vite --host 127.0.0.1 --port 5173 --strictPort",
    "build:android-engine": "vite build --config vite.android-engine.config.js",
    "check:android-engine": "node --test tests/android-engine-gateway.test.js && npm run build:android-engine"
  },
  "dependencies": {
    "manseryeok": "2.0.0"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "@playwright/test": "^1.55.0"
  }
}
